# Backend (read from repo-root .env)
GEMINI_API_KEY=
APP_SHARED_SECRET=          # long random string; also put it in android/local.properties
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_JOURNAL_MODEL=gemini-3.5-flash-lite
JOURNAL_ENABLED=true        # scheduled writing; voice tools work even when false
JOURNAL_TIME=21:30          # local HH:MM; saved dashboard time overrides; one worker
JOURNAL_TIMEZONE=America/Toronto  # omit for host local timezone
JOURNAL_DOC_ID=             # optional; otherwise finds/creates "Glasses Journal"
GEMINI_COACH_MODEL=gemini-3.5-flash
# COACH_DB_PATH=/absolute/path/to/coach.sqlite3  # optional; default backend/data/coach.sqlite3
