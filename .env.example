# Backend (read from repo-root .env)
GEMINI_API_KEY=
APP_SHARED_SECRET=          # long random string; also put it in android/local.properties
# Ordered fallback lists; override legacy single-model settings when populated.
GEMINI_LIVE_MODELS=gemini-3.8-live,gemini-3.1-flash-live-preview
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_JOURNAL_MODEL=gemini-3.5-flash-lite
JOURNAL_ENABLED=true        # scheduled writing; voice tools work even when false
JOURNAL_TIME=21:30          # local HH:MM; saved dashboard time overrides; one worker
JOURNAL_TIMEZONE=America/Toronto  # omit for host local timezone
JOURNAL_DOC_ID=             # optional; otherwise finds/creates "Glasses Journal"
GEMINI_COACH_MODEL=gemini-3.5-flash
# COACH_DB_PATH=/absolute/path/to/coach.sqlite3  # optional; default backend/data/coach.sqlite3
GEMINI_VISUAL_MODEL=gemini-3.5-flash-lite
VISUAL_RETENTION_DAYS=7      # unpinned visual history; pins survive until explicit deletion

# Local daily soft caps (NOT Google's published quotas). Quota days use Pacific time.
USAGE_LIVE_SESSIONS=20
USAGE_LIVE_MINUTES=120
USAGE_TEXT_CALLS=400
USAGE_TOTAL_TOKENS=1000000
USAGE_EVAL_PERCENT=10
# Optional shared absolute SQLite path for this backend and all local evaluation worktrees.
# USAGE_DB=/absolute/private/path/usage.sqlite3
# Copy project/model limits from AI Studio; omitted/null dimensions remain unknown.
# GEMINI_QUOTA_FILE=/absolute/private/path/gemini-quota.json
# User-confirmed label only; API successes do not prove billing status.
GEMINI_BILLING_TIER=unknown

# Background CLI agents use the Mac subscription logins, never backend API keys.
# Dashboard Settings overrides these defaults when saved.
CODEX_JOBS_ENABLED=true
CLAUDE_JOBS_ENABLED=true
CODEX_JOB_MODEL=gpt-6-astra
CLAUDE_JOB_MODEL=claude-opus-5-5
JOBS_CONCURRENCY=3
CODEX_JOB_TIMEOUT_SECONDS=3600
RESEARCH_JOB_TIMEOUT_SECONDS=1800
# Claude coding has a fixed 3600-second deadline and no shell/test execution.
